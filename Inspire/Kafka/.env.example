# ==============================================================================
# Configuración del Broker de Kafka para acceso desde Servidores / VMs externas
# ==============================================================================

# IP o Hostname de ESTE servidor Kafka, accesible desde la VM externa donde corre Inspire Scaler.
# Ejemplos: 192.168.68.60, 10.0.1.25, o kafka.midominio.com
# NOTA: NO usar 'localhost' si Scaler está en otra máquina/VM, o Scaler intentará conectarse a sí mismo.
KAFKA_ADVERTISED_HOST=192.168.68.60

# Puerto expuesto para clientes externos (Inspire Scaler)
KAFKA_EXTERNAL_PORT=9092

# Topic inicial a crear automáticamente
KAFKA_TOPIC=sensor-data
