{
  "formatVersion": "1",
  "interactive": {
    "applicationUrl": "http://localhost:30701/interactive",
    "temporaryArchiveExpirationTimeInHours": 24,
    "enableUserAdministration": true,
    "enableSystemUserAdministration": true,
    "enableInspireControl": false,
    "showCookiesInfo": false,
    "trustedDomains": [
      "localhost"
    ],
    "reloadConfigurationFiles": true,
    "secretKeys": {
      "1": "icm://Interactive/.config/salt"
    },
    "availableAuthoringLanguages": []
  },
  "http": {
    "xFrameOptions": "DENY",
    "trustedProxies": {},
    "contentSecurityPolicy": {
      "mode": "ENABLED"
    }
  },
  "database": {
    "driver": "org.postgresql.Driver",
    "url": "jdbc:postgresql://postgres:5432/interactive_db?tcpKeepAlive=true",
    "userName": "scaler",
    "password": "scalerpassword123",
    "useKerberos": false,
    "connectionPoolSize": 40,
    "encrypt": "TRUE"
  },
  "smtp": {
    "servers": []
  },
  "automation": {
    "servers": []
  },
  "scaler": {
    "servers": [
      {
        "name": "default",
        "url": "http://scaler:30600",
        "userName": "system",
        "password": "Password12345*",
        "failRetryCount": 3
      }
    ]
  },
  "elasticSearch": {
    "type": "NO",
    "performIndexing": true
  },
  "approvalProcess": {
    "administratorRoles": [
      "Administrator"
    ]
  },
  "webServices": {
    "secretKey": "default_secret_key"
  },
  "icm": {
    "states": {
      "approvalStates": {
        "approvalStates": []
      }
    }
  },
  "timeout": {
    "batch": {
      "deleteAuditMessagesOlderThanInMonths": 24,
      "deleteUserAttachmentsAndImagesOlderThanInMonths": 12
    },
    "othersTimeout": {
      "slowRequestInSeconds": 120
    },
    "privateApi": {
      "lockingIpPeriodInMillis": 60000,
      "lockingIpMaxTriesInPeriod": 1000
    },
    "systemApi": {
      "lockingIpPeriodInMillis": 60000,
      "lockingIpMaxTriesInPeriod": 200
    }
  },
  "limit": {
    "productionServerJobsPerUser": 2
  },
  "resource": {},
  "feature": {
    "enableUsersInMultipleCompanies": true,
    "scriptIntegration": {
      "restrictedPolicy": true
    }
  },
  "contentIntelligence": {},
  "logging": {
    "enableClientIdClientNameLogging": false
  }
}